# ── Database (Prisma) ────────────────────────────────────────────────────────
# SQLite (default — works offline, file lives in db/custom.db)
DATABASE_URL="file:../db/custom.db"
# Or hosted Postgres (e.g. Prisma Postgres):
# DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ── Teacher dashboard ────────────────────────────────────────────────────────
# Access code for /teacher. Leave unset only on a trusted intranet.
TEACHER_ACCESS_CODE="GURU2026"

# ── SEO ──────────────────────────────────────────────────────────────────────
# Canonical production URL, no trailing slash. Used for canonical links,
# sitemap.xml, robots.txt, Open Graph and JSON-LD. Change it once here if
# you move to a custom domain.
NEXT_PUBLIC_SITE_URL="https://pythagorean-perigal-learning-media.vercel.app"

# Google Search Console verification token ("HTML tag" method).
# Copy ONLY the token from content="..." of the meta tag GSC gives you.
NEXT_PUBLIC_GSC_VERIFICATION=""

# ── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
# Leave unset to disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
